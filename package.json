{
  "private": true,
  "name": "lolscoreboard-client",
  "version": "0.0.0",
  "description": "A client that exposes the League of Legends scoreboard data from current game via API and WebSocket",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ahmed Rangel",
    "email": "ahmedrangel@outlook.com",
    "url": "https://ahmedrangel.com"
  },
  "contributors": [
    {
      "name": "Ahmed Rangel",
      "email": "ahmedrangel@outlook.com",
      "url": "https://ahmedrangel.com"
    },
    {
      "name": "Yizack Rangel",
      "email": "yizackr@gmail.com",
      "url": "https://yizack.com"
    }
  ],
  "homepage": "https://github.com/JimRsng/lolscoreboard-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimRsng/lolscoreboard-client.git"
  },
  "bugs": "https://github.com/JimRsng/lolscoreboard-client/issues",
  "scripts": {
    "dev": "node src/index.ts --dev",
    "start": "node src/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "obuild",
    "copy:assets": "cpy src/assets/**/* dist/assets",
    "compile": "obuild && node --run copy:assets && pkg . && node scripts/metadata.ts",
    "test:types": "tsc --noEmit",
    "checks": "node --run lint && node --run test:types && node --run build",
    "release": "node --run checks && changelogen --release --no-github && git push --follow-tags",
    "release:github": "changelogen gh release"
  },
  "bin": "dist/index.mjs",
  "pkg": {
    "assets": [
      "dist/assets/**/*",
      "node_modules/not-the-systray/**/*.node"
    ],
    "targets": ["node24-win-x64"],
    "ignore": ["**/*/node_modules/*/test/**"],
    "compress": "Zstd",
    "outputPath": "pkg"
  },
  "devDependencies": {
    "@hasagi/core": "^0.10.0",
    "@hasagi/ingame-api": "^0.2.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "@whatwg-node/server": "^0.13.0",
    "@yao-pkg/pkg": "^6.22.0",
    "changelogen": "^0.6.2",
    "citty": "^0.2.2",
    "cloudflared": "^0.7.3",
    "consola": "^3.4.2",
    "cpy-cli": "^7.0.0",
    "itty-router": "^5.0.24",
    "koffi": "^3.3.1",
    "not-the-systray": "^0.3.1",
    "obuild": "^0.4.40",
    "ofetch": "^1.5.1",
    "oxlint": "^1.85.0",
    "resedit-cli": "^3.1.1",
    "systray2": "^2.1.4",
    "tiny-open": "^1.3.0",
    "twisted": "^1.83.0",
    "typescript": "^7.0.2",
    "ufo": "^1.6.4",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@12.6.0"
}
